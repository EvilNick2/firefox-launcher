{
  "name": "firefox-launcher",
  "version": "1.0.0",
  "description": "A launcher for Firefox profiles",
  "author": {
    "name": "evilnick2"
  },
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "cross-env NODE_ENV=development electron .",
    "dist": "electron-builder",
    "dist:installer": "electron-builder --win nsis && rimraf dist/win-unpacked",
    "dist:exe": "electron-builder --win portable && rimraf dist/win-unpacked",
    "dist:all": "npm run dist:installer && npm run dist:exe"
  },
  "dependencies": {
    "crypto-js": "^4.2.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^34.1.0",
    "electron-builder": "^25.1.8",
    "electron-reload": "^2.0.0-alpha.1",
    "rimraf": "^6.0.1"
  },
  "build": {
    "appId": "com.evilnick2.firefoxlauncher",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "imgs/icon.ico",
      "executableName": "firefox-launcher"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Firefox Launcher",
      "deleteAppDataOnUninstall": true
    }
  }
}
